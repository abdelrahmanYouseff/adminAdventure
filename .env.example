APP_NAME="عالم المغامرة للترفيه"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PUBLIC_URL=https://admin.adventureksa.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@updates.adventurksa.com"
MAIL_FROM_NAME="عالم المغامرة للترفيه"
MAIL_REPLY_TO_ADDRESS="support@updates.adventurksa.com"
MAIL_REPLY_TO_NAME="عالم المغامرة للترفيه"
MAIL_BCC="fahad@alzeer-group.com,farook@adv-line.com,shafiqalshaar@adv-line.com,abdelrahman.yousef@hadaf-hq.com"

# Resend (https://resend.com) — API key from Dashboard → API Keys
# MAIL_FROM_ADDRESS must use a domain verified in Resend (e.g. updates.adventurksa.com)
# In Resend dashboard: verify SPF + DKIM + DMARC for the domain to avoid spam folders.
RESEND_KEY=

# S3-compatible object storage (e.g. Hetzner Object Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=fsn1
AWS_BUCKET=
AWS_ENDPOINT=https://fsn1.your-objectstorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
# Optional override for public URL base; leave empty to use endpoint + bucket
# AWS_URL=

VITE_APP_NAME="${APP_NAME}"

# Authentica OTP (SMS login)
AUTHENTICA_BASE_URL=https://api.authentica.sa/api/v2
AUTHENTICA_API_KEY=
AUTHENTICA_TEMPLATE_ID=31
AUTHENTICA_OTP_LENGTH=4
AUTHENTICA_TIMEOUT=30
AUTHENTICA_APP_NAME=adventurworldapp

# للـ DEV فقط: يخلي أي OTP في worker-app و main-app = 0000
# (يجب تفعيله على السيرفر فقط لو أنت في بيئة اختبار)
OTP_FORCE_FIXED=false

# تخطي OTP تماماً: الدخول بالرقم مباشرة بدون رمز تحقق
OTP_SKIP_ENABLED=false

# WhatsApp Cloud API
WHATSAPP_ENABLED=false
# إشعارات الطلب الداخلية للموظفين (منفصلة عن إذن التسليم للعميل)
WHATSAPP_ORDER_NOTIFICATIONS=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# رقم الإرسال — لا يُضاف في قائمة المستلمين
WHATSAPP_BUSINESS_PHONE=966559723161
# رقم اختبار تمبلت إذن التسليم
WHATSAPP_TEST_CUSTOMER_PHONE=966538778559
# قالب معتمد في Meta Business — اتركه فارغاً حتى تنشئ القالب ثم اضبطه
# WHATSAPP_ORDER_TEMPLATE=order_new
# WHATSAPP_ORDER_TEMPLATE_LANGUAGE=ar
# WHATSAPP_DELIVERY_NOTE_TEMPLATE=order_deliver_note
# WHATSAPP_DELIVERY_NOTE_TEMPLATE_LANGUAGE=en
# زر عرض الطلب في Meta: https://www.admin.adventureksa.com/dn/{{1}}
# {{1}} = رقم إذن التسليم فقط (مثال: S-202608142)
# WHATSAPP_DELIVERY_NOTE_URL_BUTTON=true
# WHATSAPP_DELIVERY_NOTE_BUTTON_MODE=dn
# اختياري — إن لم يُضبط يُجلب تلقائياً من PHONE_NUMBER_ID
# WHATSAPP_WABA_ID=
WHATSAPP_DISPATCH_SYNC=true
WHATSAPP_GRAPH_VERSION=v21.0

# /social-media — shared password for order photo gallery
SOCIAL_MEDIA_PASSWORD=
